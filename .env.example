# Backend Server Configuration
PORT=4000
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# MongoDB Database Connection
MONGO_URL=mongodb://127.0.0.1:27017/landslide
MONGO_DB_NAME=landslide

# Hugging Face Vision API Service (Backend Only)
# Get your free access token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
HUGGINGFACE_IMAGE_MODEL=google/vit-base-patch16-224
HUGGINGFACE_API_URL=https://router.huggingface.co/hf-inference/v1/models/

# Optional Microservices & External Services
ML_SERVICE_URL=http://127.0.0.1:5000
VITE_API_BASE=
